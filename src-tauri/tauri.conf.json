{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shelf",
  "version": "0.1.0",
  "identifier": "org.shelfapp.shelf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Shelf",
        "width": 1360,
        "height": 880,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A fast ebook library that keeps your e-reader in sync",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB ebook",
        "description": "EPUB ebook",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": ["mobi", "azw3"],
        "name": "Kindle ebook",
        "description": "Kindle ebook",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
